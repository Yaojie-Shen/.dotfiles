#!/usr/bin/env bash

set -Eeuo pipefail

ACTION="install"
INSTALLER_URL="${CLAUDE_INSTALLER_URL:-https://claude.ai/install.sh}"
LAUNCH_AFTER_INSTALL=0

DEVBOX_UTILS="${DEVBOX_UTILS:-${DEVBOX_ROOT:-${HOME}/.devbox}/libexec/devbox-utils}"
if [[ ! -f "$DEVBOX_UTILS" ]]; then
  echo "Error: devbox-utils not found at: $DEVBOX_UTILS" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$DEVBOX_UTILS"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Behavior:
  - Installs or updates Claude Code using Anthropic's official native installer.
  - When CLAUDE_CODE_OAUTH_TOKEN is provided, marks the Claude Code onboarding flow complete without replacing other ~/.claude.json values.
  - Does not start Claude Code after installation unless --launch is passed.
  - Never writes authentication tokens.

Options:
  -h, --help                 Show this help message
  --status                   Show detected Claude Code and authentication state
  --doctor                   Run Claude Code's built-in diagnostic command
  --upgrade                  Update an existing Claude Code install, or install if missing
  --installer-url <URL>      Override the official installer URL
  --launch                   Start Claude Code after install or upgrade

Environment:
  CLAUDE_INSTALLER_URL       Default installer URL override
  CLAUDE_CODE_OAUTH_TOKEN    Optional OAuth token supplied by the caller; never stored by this script

Examples:
  $(basename "$0")
  $(basename "$0") --launch
  $(basename "$0") --upgrade
  $(basename "$0") --status
EOF
  exit 0
}

require_value() {
  local option="${1:-}"
  local value="${2:-}"

  if [[ -z "$value" || "$value" == -* ]]; then
    error "Missing value for $option"
    exit 1
  fi
}

command_path() {
  command -v claude 2>/dev/null || true
}

check_installer_prerequisites() {
  local missing=()

  command -v bash >/dev/null 2>&1 || missing+=(bash)
  command -v mktemp >/dev/null 2>&1 || missing+=(mktemp)
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || missing+=(curl-or-wget)

  if [[ "${#missing[@]}" -gt 0 ]]; then
    error "Missing required command(s): ${missing[*]}"
    return 1
  fi
}

download_installer() {
  local output="$1"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$INSTALLER_URL" -o "$output"
  else
    wget -q -O "$output" "$INSTALLER_URL"
  fi
}

run_installer() (
  local tmp_dir installer

  check_installer_prerequisites
  tmp_dir="$(mktemp -d)"
  installer="$tmp_dir/install.sh"
  trap 'rm -rf "$tmp_dir"' EXIT

  info "Downloading the official Claude Code installer"
  download_installer "$installer"
  bash "$installer"
)

complete_onboarding() (
  local config_file tmp_file
  config_file="${HOME}/.claude.json"

  if [[ -L "$config_file" ]]; then
    error "Refusing to replace symbolic link: $config_file"
    return 1
  fi
  if [[ -e "$config_file" && ! -f "$config_file" ]]; then
    error "Expected a regular file at $config_file"
    return 1
  fi

  tmp_file="$(mktemp "${config_file}.tmp.XXXXXX")"
  trap 'rm -f "$tmp_file"' EXIT

  if [[ -f "$config_file" ]]; then
    if ! command -v python3 >/dev/null 2>&1; then
      error "python3 is required to update the existing $config_file"
      return 1
    fi
    if ! python3 - "$config_file" >"$tmp_file" <<'PY'; then
import json
import sys

with open(sys.argv[1], encoding="utf-8") as file:
    config = json.load(file)
if not isinstance(config, dict):
    raise ValueError("Claude Code config must be a JSON object")
config["hasCompletedOnboarding"] = True
json.dump(config, sys.stdout, ensure_ascii=False, indent=2)
sys.stdout.write("\n")
PY
      error "Could not parse $config_file as JSON; leaving it unchanged"
      return 1
    fi
  else
    printf '%s\n' '{"hasCompletedOnboarding":true}' >"$tmp_file"
  fi

  chmod 600 "$tmp_file"
  mv -f "$tmp_file" "$config_file"
  chmod 600 "$config_file"
  success "Marked Claude Code onboarding as complete"
)

complete_onboarding_if_token_available() {
  if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    info "No CLAUDE_CODE_OAUTH_TOKEN was provided; leaving onboarding unchanged"
    return 0
  fi

  complete_onboarding
}

status() {
  local resolved config_file oauth_state
  resolved="$(command_path)"
  config_file="${HOME}/.claude.json"
  oauth_state="not set"
  if [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    oauth_state="provided by environment"
  fi

  info "Claude Code status"
  printf '  command on PATH: %s\n' "${resolved:-not found}"
  printf '  OAuth token:     %s\n' "$oauth_state"

  if [[ -e "$config_file" ]]; then
    printf '  config:          %s\n' "$config_file"
  else
    printf '  legacy config:   not found\n'
  fi

  if [[ -n "$resolved" ]]; then
    printf '  version:         '
    "$resolved" --version 2>/dev/null || true
  fi
}

launch_claude() {
  local resolved
  resolved="$(command_path)"

  if [[ "$LAUNCH_AFTER_INSTALL" -eq 0 ]]; then
    return 0
  fi
  if [[ -z "$resolved" ]]; then
    error "Claude Code installed but 'claude' is not on PATH. Open a new shell and run claude."
    return 1
  fi

  info "Starting Claude Code; complete authentication if prompted"
  "$resolved"
}

install() {
  run_installer
  complete_onboarding_if_token_available
  status
  launch_claude
}

upgrade() {
  local resolved
  resolved="$(command_path)"

  if [[ -n "$resolved" ]]; then
    info "Updating Claude Code"
    "$resolved" update
  else
    info "Claude Code is not installed; installing it instead"
    run_installer
  fi

  complete_onboarding_if_token_available
  status
  launch_claude
}

doctor() {
  local resolved
  resolved="$(command_path)"

  if [[ -z "$resolved" ]]; then
    error "Claude Code is not installed. Run $(basename "$0") first."
    return 1
  fi

  "$resolved" doctor
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    ;;
  --status)
    ACTION="status"
    shift
    ;;
  --doctor)
    ACTION="doctor"
    shift
    ;;
  --upgrade)
    ACTION="upgrade"
    shift
    ;;
  --installer-url)
    require_value "$1" "${2:-}"
    INSTALLER_URL="$2"
    shift 2
    ;;
  --launch)
    LAUNCH_AFTER_INSTALL=1
    shift
    ;;
  *)
    error "Unknown option: $1"
    usage
    ;;
  esac
done

case "$ACTION" in
install)
  install
  ;;
upgrade)
  upgrade
  ;;
status)
  status
  ;;
doctor)
  doctor
  ;;
esac
