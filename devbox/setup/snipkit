#!/usr/bin/env bash

set -Eeuo pipefail

PACKAGE_MANAGER=""

DEVBOX_UTILS="${DEVBOX_UTILS:-${DEVBOX_ROOT:-${HOME}/.devbox}/libexec/devbox-utils}"
if [[ ! -f "$DEVBOX_UTILS" ]]; then
  echo "Error: devbox-utils not found at: $DEVBOX_UTILS" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$DEVBOX_UTILS"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Install snipkit using Homebrew, APT, DNF, or YUM according to the current system.

Options:
  -h, --help    Show this help message
EOF
}

check_requirements() {
  local os
  os="$(uname -s)"
  PACKAGE_MANAGER="$(detect_package_manager)"

  case "$PACKAGE_MANAGER" in
  brew | apt-get | dnf | yum) ;;
  *)
    error "Unsupported system or package manager: ${os}/${PACKAGE_MANAGER}"
    error "Supported methods: Homebrew, APT, DNF, and YUM"
    exit 1
    ;;
  esac

  if ! command -v "$PACKAGE_MANAGER" >/dev/null 2>&1; then
    error "$PACKAGE_MANAGER is required to install snipkit"
    exit 1
  fi

  if [[ "$PACKAGE_MANAGER" != "brew" ]] && ! command -v sudo >/dev/null 2>&1; then
    error "sudo is required to install snipkit with $PACKAGE_MANAGER"
    exit 1
  fi
}

install() {
  if command -v snipkit >/dev/null 2>&1; then
    success "snipkit is already installed: $(command -v snipkit)"
    return 0
  fi

  case "$PACKAGE_MANAGER" in
  brew)
    info "Installing snipkit via Homebrew..."
    brew install lemoony/tap/snipkit
    ;;
  apt-get)
    info "Adding the snipkit APT repository..."
    printf '%s\n' 'deb [trusted=yes] https://apt.fury.io/lemoony/ /' |
      sudo tee /etc/apt/sources.list.d/snipkit.list >/dev/null

    info "Updating APT package indexes..."
    sudo apt-get update

    info "Installing snipkit via APT..."
    sudo apt-get install -y --no-install-recommends snipkit
    ;;
  dnf | yum)
    info "Adding the snipkit YUM repository..."
    printf '%s\n' \
      '[snipkit]' \
      'name=Snipkit Private Repo' \
      'baseurl=https://yum.fury.io/lemoony/' \
      'enabled=1' \
      'gpgcheck=0' |
      sudo tee /etc/yum.repos.d/snipkit.repo >/dev/null

    info "Installing snipkit via ${PACKAGE_MANAGER}..."
    sudo "$PACKAGE_MANAGER" install -y snipkit
    ;;
  esac

  success "snipkit installed successfully!"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  *)
    error "Unknown option: $1"
    usage >&2
    exit 1
    ;;
  esac
done

check_requirements
install
